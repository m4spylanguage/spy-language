fn is_digit(c):
    if c >= 48 and c <= 57:
        return 1
    return 0

fn is_alpha(c):
    if c >= 65 and c <= 90:
        return 1
    if c >= 97 and c <= 122:
        return 1
    return 0

fn is_alnum(c):
    if is_alpha(c) or is_digit(c):
        return 1
    return 0

fn count_tokens(source: *char):
    let n = len(source)
    let count = 0
    let i = 0
    while i < n:
        let c = source[i]
        if c == 10:
            count = count + 1
        i = i + 1
    return count

fn main():
    let source = read_file("self_lexer.spy")
    let count = count_tokens(source)
    print(count)
