fn is_digit(c):
    if c >= 48 and c <= 57:
        return 1
    return 0

fn main():
    let source = "abc123"
    let n = len(source)
    let i = 0
    while i < n:
        let c = source[i]
        if is_digit(c):
            print(c)
        i = i + 1
    print("done")
