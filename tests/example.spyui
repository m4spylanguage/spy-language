import <spyui.h>

fn main():
    let win = SWindow("File Manager", 800, 600)
    let sidebar = SFrame(250, 600)
    let content = SFrame(550, 600)
    let tabs = STabs()
    let path_input = SInput("Enter path...")
    let go_btn = SToolButton("Go")
    let back_btn = SToolButton("<")
    let up_btn = SToolButton("^")
    let splitter = SSplitter(1)
    let hbox = SHBoxLayout()
    hbox.add(sidebar)
    hbox.add(splitter)
    hbox.add(content)
    win.set_layout(hbox)
    win.set_title("Spy File Manager")
    win.set_size(1200, 800)
    win.show()
