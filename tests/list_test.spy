fn main():
    let a = list()
    let b = list(10, 20, 30)
    print("empty:", a)
    print("three:", b)
    print("len:", len(b))
    b.push(40)
    print("after push:", b)
    let x = b.pop()
    print("popped:", x)
    print("after pop:", b)
    let g = b.get(1)
    print("get(1):", g)
    b.set(0, 99)
    print("after set:", b)
    print("b[1]:", b[1])
    b[1] = 55
    print("after b[1]=55:", b)
