struct Token:
    kind: *char
    value: *char
    line: i32
    column: i32

fn main():
    let source: *char = "hello world"
    print(len(source))
    print(source[0])
    print(source[1])

    let count = 3
    let tokens: *Token = alloc[Token](count)
    print(tokens)

    let ti = 0
    tokens[ti].kind = "NUMBER"
    tokens[ti].value = "42"
    tokens[ti].line = 1
    tokens[ti].column = 5
    print(tokens[ti].kind)
    print(tokens[ti].value)
    print(tokens[ti].line)
    print(tokens[ti].column)
