fn main():
    print(10 + 20)
    print(50 - 15)
    print(6 * 7)
    print(100 / 4)
    print(10 == 10)
    print(10 == 99)
    print(5 < 10)
    print(10 > 5)
    print(5 >= 5)
    print(10 <= 5)
