fn identity[T](val: i32) -> i32:
    return val

fn main() -> i32:
    let ptr: *u32 = alloc[u32](4)
    let val: i32 = 42
    let res: i32 = identity(val)
    printf("Generics Test Output: %d\n", res)
    free(ptr)
    return 0
