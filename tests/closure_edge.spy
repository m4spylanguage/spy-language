fn main():
    let y = 42
    let f = (x) => x + y
    let r1 = f(5)
    print("Test1: " + str(r1))
    let a = 10
    let b = 20
    let g = (x) => x + a + b
    let r2 = g(5)
    print("Test2: " + str(r2))
    let h = (x) => x * 2
    let r3 = h(5)
    print("Test3: " + str(r3))
    let j = (x) => x + a
    let k = (x) => x + b
    let r4a = j(1)
    let r4b = k(2)
    print("Test4: " + str(r4a) + " " + str(r4b))
    let z = 100
    if true:
        let w = (x) => x + z
        let r6 = w(1)
        print("Test6: " + str(r6))
    let counter = 0
    let inc = (x) => x + counter
    let r7a = inc(10)
    let r7b = inc(20)
    print("Test7: " + str(r7a) + " " + str(r7b))
    print("DONE")
